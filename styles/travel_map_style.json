{
  "version": 8,
  "name": "Travel Map",
  "metadata": {
    "theme": {
      "countries": {
        "fill": "#93c5fd",
        "line": "#1d4ed8",
        "hoverFill": "#1748d8",
        "hoverLine": "#103aab",
        "fadedFill": "#e8f0ff",
        "fadedLine": "#d7e4ff"
      },
      "cities": {
        "fill": "#fbbf24",
        "hoverFill": "#f59e0b",
        "fadedFill": "#fbbf24"
      },
      "airports": {
        "fill": "#13b8a6",
        "hoverFill": "#0d9488",
        "fadedFill": "#99f6e4"
      },
      "routes": {
        "level1": "#f59e0b",
        "level2": "#f97316",
        "level3": "#ef4444",
        "level4": "#c026d3",
        "level5": "#7c3aed"
      },
      "ui": {
        "bgTop": "#eef6ff",
        "bgBottom": "#dfeeff"
      },
      "sizes": {
        "countries": {
          "lineWidth": 1.4,
          "hoverLineWidth": 2.3,
          "fillOpacity": 0.78,
          "hoverFillOpacity": 0.96
        },
        "cities": {
          "baseRadius": 2.5,
          "baseStrokeWidth": 1,
          "hoverRadius": 3.5,
          "hoverStrokeWidth": 1.5
        },
        "airports": {
          "baseRadius": 2,
          "baseStrokeWidth": 0.8,
          "hoverRadius": 3,
          "hoverStrokeWidth": 1.2
        },
        "routes": {
          "baseWidth": 2.3,
          "baseOpacity": 0.85,
          "hoverWidth": 2.8,
          "hoverOpacity": 0.96
        }
      }
    }
  },
  "transition": {
    "duration": 250,
    "delay": 0
  },
  "glyphs": "https://demotiles.maplibre.org/font/{fontstack}/{range}.pbf",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://demotiles.maplibre.org/tiles/tiles.json"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#eef6ff"
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": {
        "fill-color": "#cfe8ff"
      }
    },
    {
      "id": "landcover",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "paint": {
        "fill-color": "#dfeeff",
        "fill-opacity": 0.35
      }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
      "paint": {
        "fill-color": "#e6f4ea",
        "fill-opacity": 0.55
      }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#b9ddff",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          3,
          0.3,
          8,
          0.8,
          12,
          1.2
        ],
        "line-opacity": 0.8
      }
    },
    {
      "id": "country-boundary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "filter": [
        "<=",
        [
          "coalesce",
          [
            "get",
            "admin_level"
          ],
          99
        ],
        2
      ],
      "paint": {
        "line-color": "#c9d8f2",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          1,
          0.4,
          4,
          0.7,
          8,
          1.0
        ],
        "line-opacity": 0.75
      }
    },
    {
      "id": "place-labels-country",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": [
        "==",
        [
          "get",
          "class"
        ],
        "country"
      ],
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name_en"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          0,
          10,
          4,
          12
        ]
      },
      "paint": {
        "text-color": "#6b7da3",
        "text-halo-color": "rgba(255,255,255,0.82)",
        "text-halo-width": 1
      }
    },
    {
      "id": "place-labels-city",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": [
        "match",
        [
          "get",
          "class"
        ],
        [
          "city",
          "town"
        ],
        true,
        false
      ],
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name_en"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          3,
          9,
          8,
          11
        ]
      },
      "paint": {
        "text-color": "#8b9bb8",
        "text-halo-color": "rgba(255,255,255,0.82)",
        "text-halo-width": 1
      }
    }
  ]
}
