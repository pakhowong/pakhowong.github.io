{
  "version": 8,
  "name": "Travel Map",
  "metadata": {
    "theme": {
      "countries": {
        "fill": "#93c5fd",
        "line": "#1d4ed8",
        "hoverFill": "#1748d8",
        "hoverLine": "#103aab",
        "fadedFill": "#e8f0ff",
        "fadedLine": "#d7e4ff"
      },
      "cities": {
        "fill": "#fbbf24",
        "hoverFill": "#f59e0b",
        "fadedFill": "#fbbf24",
        "line": "#b45309",
        "hoverLine": "#b45309",
        "fadedLine": "#d9efe5"
      },
      "airports": {
        "fill": "#13b8a6",
        "hoverFill": "#0d9488",
        "fadedFill": "#99f6e4",
        "line": "#ffffff",
        "hoverLine": "#ffffff",
        "fadedLine": "#d7f7f1"
      },
      "routes": {
        "level1": "#f59e0b",
        "level2": "#f97316",
        "level3": "#ef4444",
        "level4": "#c026d3",
        "level5": "#7c3aed"
      },
      "ui": {
        "bgTop": "#eef6ff",
        "bgBottom": "#dfeeff"
      },
      "sizes": {
        "countries": {
          "lineWidth": 1.4,
          "hoverLineWidth": 2.3,
          "fillOpacity": 0.78,
          "hoverFillOpacity": 0.96
        },
        "cities": {
          "baseRadius": 2.5,
          "baseStrokeWidth": 1,
          "hoverRadius": 3.5,
          "hoverStrokeWidth": 1.5
        },
        "airports": {
          "baseRadius": 2,
          "baseStrokeWidth": 0.8,
          "hoverRadius": 3,
          "hoverStrokeWidth": 1.2
        },
        "routes": {
          "baseWidth": 2.3,
          "baseOpacity": 0.85,
          "hoverWidth": 2.8,
          "hoverOpacity": 0.96
        }
      },
      "baseMap": {
        "water": "#f8fbff",
        "land": "#dff0ff",
        "landShadow": "#bcd2f7",
        "border": "#94aeea",
        "waterway": "#b9ddff",
        "label": "#6b7da3",
        "subLabel": "#8b9bb8",
        "coastline": "#7da2e3"
      }
    }
  },
  "transition": {
    "duration": 250,
    "delay": 0
  },
  "glyphs": "https://fonts.openmaptiles.org/{fontstack}/{range}.pbf",
  "sources": {
    "maplibre-world": {
      "type": "vector",
      "url": "https://demotiles.maplibre.org/tiles/tiles.json"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#f8fbff"
      }
    },
    {
      "id": "basemap-countries-fill",
      "type": "fill",
      "source": "maplibre-world",
      "source-layer": "countries",
      "paint": {
        "fill-color": "#dff0ff",
        "fill-opacity": 1.0,
        "fill-outline-color": "#bcd2f7"
      }
    },
    {
      "id": "basemap-coastline",
      "type": "line",
      "source": "maplibre-world",
      "source-layer": "coastline",
      "paint": {
        "line-color": "#7da2e3",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          0,
          0.8,
          3,
          1.5,
          6,
          2.2
        ],
        "line-opacity": 0.8
      }
    },
    {
      "id": "basemap-countries-line",
      "type": "line",
      "source": "maplibre-world",
      "source-layer": "countries",
      "paint": {
        "line-color": "#94aeea",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          0,
          0.6,
          3,
          1.2,
          6,
          1.8
        ],
        "line-opacity": 0.9
      }
    }
  ]
}
