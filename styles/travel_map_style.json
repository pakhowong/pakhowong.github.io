{
  "version": 8,
  "name": "Travel Map",
  "metadata": {
    "theme": {
      "countries": {
        "fill": "#93c5fd",
        "line": "#1d4ed8",
        "hoverFill": "#1748d8",
        "hoverLine": "#103aab",
        "fadedFill": "#e8f0ff",
        "fadedLine": "#d7e4ff"
      },
      "cities": {
        "fill": "#fbbf24",
        "hoverFill": "#f59e0b",
        "fadedFill": "#fbbf24"
      },
      "airports": {
        "fill": "#13b8a6",
        "hoverFill": "#0d9488",
        "fadedFill": "#99f6e4"
      },
      "routes": {
        "level1": "#f59e0b",
        "level2": "#f97316",
        "level3": "#ef4444",
        "level4": "#c026d3",
        "level5": "#7c3aed"
      },
      "ui": {
        "bgTop": "#eef6ff",
        "bgBottom": "#dfeeff"
      },
      "sizes": {
        "countries": {
          "lineWidth": 1.4,
          "hoverLineWidth": 2.3,
          "fillOpacity": 0.78,
          "hoverFillOpacity": 0.96
        },
        "cities": {
          "baseRadius": 2.5,
          "baseStrokeWidth": 1,
          "hoverRadius": 3.5,
          "hoverStrokeWidth": 1.5
        },
        "airports": {
          "baseRadius": 2,
          "baseStrokeWidth": 0.8,
          "hoverRadius": 3,
          "hoverStrokeWidth": 1.2
        },
        "routes": {
          "baseWidth": 2.3,
          "baseOpacity": 0.85,
          "hoverWidth": 2.8,
          "hoverOpacity": 0.96
        }
      }
    }
  },
  "transition": {
    "duration": 250,
    "delay": 0
  },
  "sources": {
    "voyager-base": {
      "type": "raster",
      "tiles": [
        "https://a.basemaps.cartocdn.com/rastertiles/voyager_nolabels/{z}/{x}/{y}{r}.png",
        "https://b.basemaps.cartocdn.com/rastertiles/voyager_nolabels/{z}/{x}/{y}{r}.png",
        "https://c.basemaps.cartocdn.com/rastertiles/voyager_nolabels/{z}/{x}/{y}{r}.png",
        "https://d.basemaps.cartocdn.com/rastertiles/voyager_nolabels/{z}/{x}/{y}{r}.png"
      ],
      "tileSize": 256,
      "attribution": "&copy; OpenStreetMap contributors &copy; CARTO"
    },
    "voyager-labels": {
      "type": "raster",
      "tiles": [
        "https://a.basemaps.cartocdn.com/rastertiles/voyager_only_labels/{z}/{x}/{y}{r}.png",
        "https://b.basemaps.cartocdn.com/rastertiles/voyager_only_labels/{z}/{x}/{y}{r}.png",
        "https://c.basemaps.cartocdn.com/rastertiles/voyager_only_labels/{z}/{x}/{y}{r}.png",
        "https://d.basemaps.cartocdn.com/rastertiles/voyager_only_labels/{z}/{x}/{y}{r}.png"
      ],
      "tileSize": 256,
      "attribution": "&copy; OpenStreetMap contributors &copy; CARTO"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#eaf6ff"
      }
    },
    {
      "id": "voyager-base",
      "type": "raster",
      "source": "voyager-base",
      "paint": {
        "raster-opacity": 0.92,
        "raster-saturation": 0.15
      }
    },
    {
      "id": "voyager-labels",
      "type": "raster",
      "source": "voyager-labels",
      "paint": {
        "raster-opacity": 0.82
      }
    }
  ]
}
